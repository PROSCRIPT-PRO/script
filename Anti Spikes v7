--==================================================
-- MOBILE DRAG
--==================================================

local function MakeDraggable(Object, Handle)
    local dragging = false
    local dragStart
    local startPosition
    local dragInput

    Handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Object.Position

            input.Changed:Connect(function()
                if input.UserInputState ==
                    Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart

            Object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

MakeDraggable(Main, Title)
MakeDraggable(Show, Show)

--==================================================
-- DETECT SPIKES MODELS
--==================================================

local function HasChildNamed(Model, TargetName)
    for _, obj in ipairs(Model:GetDescendants()) do
        if obj.Name:lower() == TargetName:lower() then
            return true
        end
    end

    return false
end

local function IsSpikeModel(Model)
    if not Model:IsA("Model") then
        return false
    end

    return HasChildNamed(Model, "Hitbox")
        and HasChildNamed(Model, "RootPart")
        and HasChildNamed(Model, "Touchy")
end

--==================================================
-- STORAGE
--==================================================

local SpikeData = {}

local function RemoveSpike(Model)
    local Data = SpikeData[Model]

    if not Data then
        return
    end

    if Data.Highlight then
        Data.Highlight:Destroy()
    end

    if Data.Shield then
        Data.Shield:Destroy()
    end

    SpikeData[Model] = nil
end

--==================================================
-- CREATE HIGHLIGHT
--==================================================

local function CreateHighlight(Model, Data)
    if Data.Highlight then
        return
    end

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "AntiSpikesV7_Highlight"
    Highlight.Adornee = Model
    Highlight.FillColor = Color3.fromRGB(0, 190, 255)
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.FillTransparency = 0.65
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = Model

    Data.Highlight = Highlight
end

--==================================================
-- CREATE FULL MODEL SHIELD
--==================================================

local function CreateShield(Model, Data)
    if Data.Shield then
        return
    end

    local Shield = Instance.new("Part")
    Shield.Name = SHIELD_NAME
    Shield.Anchored = true
    Shield.CanCollide = true
    Shield.CanTouch = false
    Shield.CanQuery = false
    Shield.Transparency = 1
    Shield.CastShadow = false
    Shield.Material = Enum.Material.ForceField
    Shield.Color = ACCENT
    Shield.Size = Vector3.new(1, 1, 1)
    Shield.Parent = Workspace

    Data.Shield = Shield
end

--==================================================
-- UPDATE SHIELD BOUNDING BOX
--==================================================

local function UpdateShield(Model, Data)
    if not Data.Shield then
        return
    end

    if not Model.Parent then
        return
    end

    local success, BoxCFrame, BoxSize = pcall(function()
        return Model:GetBoundingBox()
    end)

    if not success then
        return
    end

    Data.Shield.CFrame = BoxCFrame
    Data.Shield.Size = BoxSize
end

--==================================================
-- FIND PLAYER DISTANCE
--==================================================

local function GetRoot()
    local Character = LP.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
end

local function GetDistance(Model)
    local Root = GetRoot()

    if not Root then
        return math.huge
    end

    local success, Pivot = pcall(function()
        return Model:GetPivot()
    end)

    if not success then
        return math.huge
    end

    return (Root.Position - Pivot.Position).Magnitude
end

