--==================================================
-- NOTIFICATION
--==================================================

local LastWarning = 0

local function Warn()
    if not WARNING_ENABLED then
        return
    end

    if os.clock() - LastWarning < 3 then
        return
    end

    LastWarning = os.clock()

    pcall(function()
        game:GetService("StarterGui"):SetCore(
            "SendNotification",
            {
                Title = "ANTI SPIKES",
                Text = "Warning! Spike nearby!",
                Duration = 2
            }
        )
    end)
end

--==================================================
-- MAIN UPDATE
--==================================================

local Timer = 0

local function Update()
    if not ENABLED then
        for Model, Data in pairs(SpikeData) do
            if Data.Shield then
                Data.Shield.CanCollide = false
            end

            if Data.Highlight then
                Data.Highlight.Enabled = false
            end
        end

        Status.Text = "Status: Disabled"
        return
    end

    local Found = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and IsSpikeModel(obj) then
            table.insert(Found, obj)
        end
    end

    -- Remove old models
    for Model, Data in pairs(SpikeData) do
        if not Model.Parent or not table.find(Found, Model) then
            RemoveSpike(Model)
        end
    end

    -- Add new models
    for _, Model in ipairs(Found) do
        if not SpikeData[Model] then
            SpikeData[Model] = {}
        end

        local Data = SpikeData[Model]

        if SHIELD_ENABLED then
            CreateShield(Model, Data)
            UpdateShield(Model, Data)

            if Data.Shield then
                Data.Shield.CanCollide = true
            end
        elseif Data.Shield then
            Data.Shield.CanCollide = false
        end
    end

    -- Sort by distance
    local Sorted = {}

    for _, Model in ipairs(Found) do
        table.insert(Sorted, {
            Model = Model,
            Distance = GetDistance(Model)
        })
    end

    table.sort(Sorted, function(a, b)
        return a.Distance < b.Distance
    end)

    -- Highlight nearest 5
    for index, Item in ipairs(Sorted) do
        local Data = SpikeData[Item.Model]

        if Data then
            if HIGHLIGHT_ENABLED and index <= MAX_HIGHLIGHT then
                CreateHighlight(Item.Model, Data)

                if Data.Highlight then
                    Data.Highlight.Enabled = true
                end
            elseif Data.Highlight then
                Data.Highlight.Enabled = false
            end
        end
    end

    -- Warning nearest spike
    if Sorted[1] and Sorted[1].Distance <= WARNING_DISTANCE then
        Warn()
    end

    Status.Text = "Status: " .. #Found ..
        " Models | Nearest: " ..
        (Sorted[1] and math.floor(Sorted[1].Distance) .. " studs"
        or "None")
end

