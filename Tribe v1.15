--==================================================
-- ANTI WATER V2 (LOCAL RIVER REPLACEMENT)
--==================================================

local function EnsureAntiWaterFolder()
	if AntiWaterFolder and AntiWaterFolder.Parent then
		return AntiWaterFolder
	end

	AntiWaterFolder = workspace:FindFirstChild(ANTI_WATER_FOLDER_NAME)
	if not AntiWaterFolder then
		AntiWaterFolder = Instance.new("Folder")
		AntiWaterFolder.Name = ANTI_WATER_FOLDER_NAME
		AntiWaterFolder.Parent = workspace
	end
	return AntiWaterFolder
end

local function RestoreAntiWaterV2()
	for original, info in pairs(AntiWaterCache) do
		if original and original.Parent and original:IsA("BasePart") then
			original.LocalTransparencyModifier = info.OriginalTransparency
		end
		if info.Replacement and info.Replacement.Parent then
			info.Replacement:Destroy()
		end
	end
	table.clear(AntiWaterCache)

	if AntiWaterFolder and AntiWaterFolder.Parent then
		AntiWaterFolder:Destroy()
	end
	AntiWaterFolder = nil
end

local function CreateRiverReplacement(original)
	if not original or not original:IsA("BasePart") then return end

	local cached = AntiWaterCache[original]
	if cached and cached.Replacement and cached.Replacement.Parent then
		local replacement = cached.Replacement
		replacement.Size = original.Size
		replacement.CFrame = original.CFrame
		replacement.Color = original.Color
		replacement.Material = original.Material
		original.LocalTransparencyModifier = 1
		return
	end

	local replacement = Instance.new("Part")
	replacement.Name = "AntiWaterCollision"
	replacement.Size = original.Size
	replacement.CFrame = original.CFrame
	replacement.Color = original.Color
	replacement.Material = original.Material
	replacement.Transparency = 0
	replacement.Anchored = true
	replacement.CanCollide = true
	replacement.CanTouch = false
	replacement.CanQuery = false
	replacement.CastShadow = false
	replacement.TopSurface = Enum.SurfaceType.Smooth
	replacement.BottomSurface = Enum.SurfaceType.Smooth
	replacement.Parent = EnsureAntiWaterFolder()

	AntiWaterCache[original] = {
		OriginalTransparency = original.LocalTransparencyModifier,
		Replacement = replacement
	}
	original.LocalTransparencyModifier = 1
end

local function ScanRiverParts()
	if not ANTI_WATER_V2 then return end
	local found = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name:lower() == "river" then
			found[obj] = true
			CreateRiverReplacement(obj)
		end
	end

	for original, info in pairs(AntiWaterCache) do
		if not original or not original.Parent or not found[original] then
			if original and original.Parent and original:IsA("BasePart") then
				original.LocalTransparencyModifier = info.OriginalTransparency
			end
			if info.Replacement and info.Replacement.Parent then
				info.Replacement:Destroy()
			end
			AntiWaterCache[original] = nil
		end
	end
end

AntiWaterV2Button.MouseButton1Click:Connect(function()
	ANTI_WATER_V2 = not ANTI_WATER_V2
	AntiWaterV2Button.Text = ANTI_WATER_V2 and "ANTI WATER V2 : ON" or "ANTI WATER V2 : OFF"
	AntiWaterV2Button.BackgroundColor3 = ANTI_WATER_V2 and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)

	if ANTI_WATER_V2 then
		ScanRiverParts()
	else
		RestoreAntiWaterV2()
	end
end)

-- Initial state and periodic scan.
if ANTI_WATER_V2 then
	task.defer(ScanRiverParts)
end

task.spawn(function()
	while Gui.Parent do
		if ANTI_WATER_V2 then
			ScanRiverParts()
		end
		task.wait(ANTI_WATER_SCAN_INTERVAL)
	end
end)

