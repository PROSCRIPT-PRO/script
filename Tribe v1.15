--==================================================
-- TAB SWITCH
--==================================================

local CurrentTab = nil
local TabAnimating = false
local function OpenTab(name)
    if CurrentTab == name or TabAnimating then return end
    CurrentTab = name
    TabAnimating = true

    for pageName, page in pairs(Pages) do
        if pageName == name then
            page.Visible = true
            page.Position = UDim2.fromOffset(12, 0)
            PlayTween(page, TAB_TWEEN, {Position = UDim2.fromOffset(0, 0)})
        else
            page.Visible = false
            page.Position = UDim2.fromOffset(0, 0)
        end
    end

    for buttonName, button in pairs(SidebarButtons) do
        if buttonName == name then
            PlayTween(button, TAB_TWEEN, {BackgroundColor3 = Color3.fromRGB(0,135,205)})
            button.TextColor3 = Color3.new(1,1,1)
        else
            PlayTween(button, TAB_TWEEN, {BackgroundColor3 = Color3.fromRGB(27,39,56)})
            button.TextColor3 = Color3.fromRGB(220,220,220)
        end
    end
    task.delay(0.2, function() TabAnimating = false end)
end
MainTab.MouseButton1Click:Connect(function() OpenTab("MAIN") end)
AimTab.MouseButton1Click:Connect(function() OpenTab("AIM") end)
SpeedTab.MouseButton1Click:Connect(function() OpenTab("SPEED") end)
AntiTab.MouseButton1Click:Connect(function() OpenTab("ANTI") end)
