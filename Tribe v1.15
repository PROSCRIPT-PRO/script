	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(53,91,122)
	Stroke.Transparency = 0.65
	Stroke.Thickness = 1
	Stroke.Parent = Button
	AddPressAnimation(Button)

	SidebarButtons[text] = Button
