--==================================================
-- UI MICRO-ANIMATIONS
--==================================================

-- Subtle hover/press feedback for interactive buttons.
local function AddButtonMotion(button)
    if not button:IsA("TextButton") or button == Hide or button == Show then return end
    local baseSize = button.Size
    button.MouseButton1Down:Connect(function()
        PlayTween(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = math.clamp(button.BackgroundTransparency + 0.08, 0, 1)
        })
    end)
    button.MouseButton1Up:Connect(function()
        PlayTween(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0
        })
    end)
end

for _, item in ipairs(Gui:GetDescendants()) do
    AddButtonMotion(item)
end
Gui.DescendantAdded:Connect(function(item)
    if item:IsA("TextButton") then
        task.defer(function()
            if item.Parent then AddButtonMotion(item) end
        end)
    end
end)

