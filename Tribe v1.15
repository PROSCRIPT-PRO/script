local function SetAntiSlow(enabled)
    ANTI_SLOW = enabled
    if enabled and Humanoid and Humanoid.Parent then
        ANTI_SLOW_BASE_SPEED = Humanoid.WalkSpeed
    elseif not enabled and Humanoid and Humanoid.Parent and ANTI_SLOW_BASE_SPEED ~= nil then
        Humanoid.WalkSpeed = ANTI_SLOW_BASE_SPEED
        ANTI_SLOW_BASE_SPEED = nil
    end
    AntiSlowButton.Text = "ANTI SLOW : "..(enabled and "ON" or "OFF").." (SPEED 19)"
    AntiSlowButton.BackgroundColor3 = enabled and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)
end

AntiSlowButton.MouseButton1Click:Connect(function()
    SetAntiSlow(not ANTI_SLOW)
end)

local function SetAntiSlowBeta(enabled)
    ANTI_SLOW_BETA = enabled
    if Humanoid and Humanoid.Parent then
        if enabled then
            ANTI_SLOW_BASE_HIP = Humanoid.HipHeight
            Humanoid.HipHeight = ANTI_SLOW_BASE_HIP + 0.1
        elseif ANTI_SLOW_BASE_HIP ~= nil then
            Humanoid.HipHeight = ANTI_SLOW_BASE_HIP
            ANTI_SLOW_BASE_HIP = nil
        end
    end
    AntiSlowBetaButton.Text = "ANTI SLOW BETA : "..(enabled and "ON" or "OFF").." (Y +0.1)"
    AntiSlowBetaButton.BackgroundColor3 = enabled and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)
end

AntiSlowBetaButton.MouseButton1Click:Connect(function()
    SetAntiSlowBeta(not ANTI_SLOW_BETA)
end)

task.spawn(function()
    while Gui.Parent do
        if ANTI_SLOW and Humanoid and Humanoid.Parent and Humanoid.Health > 0 then
            Humanoid.WalkSpeed = 19
        end
        if ANTI_SLOW_BETA and Humanoid and Humanoid.Parent then
            if ANTI_SLOW_BASE_HIP == nil then
                ANTI_SLOW_BASE_HIP = Humanoid.HipHeight
            end
            local targetHip = ANTI_SLOW_BASE_HIP + 0.1
            if math.abs(Humanoid.HipHeight-targetHip) > 0.001 then
                Humanoid.HipHeight = targetHip
            end
        end
        task.wait(0.15)
    end
end)

