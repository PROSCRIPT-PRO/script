-- Animation scale: pop-in / pop-out
local MainScale = Instance.new("UIScale")
MainScale.Scale = 0.94
MainScale.Parent = Main

local OPEN_TWEEN = TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local CLOSE_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local TAB_TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local function PlayTween(object, info, properties)
    local tween = TweenService:Create(object, info, properties)
    tween:Play()
    return tween
end

-- Press-and-hold feedback: gently shrink the button and brighten its border.
local PRESS_TWEEN = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_TWEEN = TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local function AddPressAnimation(button)
    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = button

    local stroke = button:FindFirstChildOfClass("UIStroke")
    local normalStrokeColor = stroke and stroke.Color or nil
    local normalStrokeTransparency = stroke and stroke.Transparency or nil

    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end

    button.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        PlayTween(scale, PRESS_TWEEN, {Scale = 0.94})
        if stroke then
            PlayTween(stroke, PRESS_TWEEN, {
                Color = Color3.fromRGB(90, 210, 255),
                Transparency = 0.05
            })
        end
    end)

    button.InputEnded:Connect(function(input)
        if not isPress(input) then return end
        PlayTween(scale, RELEASE_TWEEN, {Scale = 1})
        if stroke and normalStrokeColor then
            PlayTween(stroke, RELEASE_TWEEN, {
                Color = normalStrokeColor,
                Transparency = normalStrokeTransparency
            })
        end
    end)
end

