PlayerWarningGui.Parent = PG
PlayerWarningLabel = Instance.new("TextLabel")
PlayerWarningLabel.AnchorPoint = Vector2.new(0.5,0)
PlayerWarningLabel.Position = UDim2.new(0.5,0,0,45)
PlayerWarningLabel.Size = UDim2.fromOffset(280,34)
PlayerWarningLabel.BackgroundColor3 = Color3.fromRGB(35,25,25)
PlayerWarningLabel.BackgroundTransparency = 0.15
PlayerWarningLabel.TextColor3 = Color3.fromRGB(255,100,100)
PlayerWarningLabel.Font = Enum.Font.GothamBold
PlayerWarningLabel.TextSize = 12
PlayerWarningLabel.Text = ""
PlayerWarningLabel.Parent = PlayerWarningGui
Instance.new("UICorner",PlayerWarningLabel).CornerRadius = UDim.new(0,8)

task.spawn(function()
    while Gui.Parent do
        if MISC_PLAYER_WARNING and Root and Root.Parent then
            local nearest,nearestDistance = nil,PLAYER_WARNING_DISTANCE + 0.001
            for _,player in ipairs(Players:GetPlayers()) do
                if player ~= LP and player.Character then
                    local otherRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    local otherHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
                        local distance = (Root.Position-otherRoot.Position).Magnitude
                        if distance <= PLAYER_WARNING_DISTANCE and distance < nearestDistance then
                            nearest,nearestDistance = player,distance
                        end
                    end
                end
            end
            if nearest then
                PlayerWarningGui.Enabled = true
                PlayerWarningLabel.Text = "⚠ PLAYER NEARBY: "..nearest.Name.." ("..math.floor(nearestDistance).." studs)"
            else
                PlayerWarningGui.Enabled = false
            end
        else
            PlayerWarningGui.Enabled = false
        end
        task.wait(0.25)
    end
end)

