local OPTIMIZE_ENABLED = false
local OptimizeSaved = {}
local OptimizeConnections = {}

PageTitle(OptimizePage,"TỐI ƯU")
local OptimizeButton = CreateButton(OptimizePage,"TỐI ƯU SCRIPT : OFF",45)
local OptimizeInfo = Instance.new("TextLabel")
OptimizeInfo.Size = UDim2.new(1,-20,0,66)
OptimizeInfo.Position = UDim2.fromOffset(10,88)
OptimizeInfo.BackgroundTransparency = 1
OptimizeInfo.Text = "Giảm hiệu ứng hình ảnh và bóng đổ cục bộ để hỗ trợ FPS. Có thể bật/tắt và khôi phục trạng thái ban đầu."
OptimizeInfo.TextColor3 = Color3.fromRGB(180,180,180)
OptimizeInfo.Font = Enum.Font.Gotham
OptimizeInfo.TextSize = 10
OptimizeInfo.TextWrapped = true
OptimizeInfo.TextXAlignment = Enum.TextXAlignment.Left
OptimizeInfo.TextYAlignment = Enum.TextYAlignment.Top
OptimizeInfo.Parent = OptimizePage

local function ApplyLocalOptimization(instance)
    if not OPTIMIZE_ENABLED or not instance or not instance.Parent then return end

    local ok, property, oldValue = pcall(function()
        if instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam")
            or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") then
            return "Enabled", instance.Enabled
        elseif instance:IsA("PostEffect") then
            return "Enabled", instance.Enabled
        elseif instance:IsA("BasePart") then
            return "CastShadow", instance.CastShadow
        end
        return nil, nil
    end)

    if ok and property then
        if OptimizeSaved[instance] == nil then
            OptimizeSaved[instance] = {property = property, value = oldValue}
        end
        pcall(function() instance[property] = false end)
    end
end

local function SetOptimize(enabled)
    OPTIMIZE_ENABLED = enabled
    if enabled then
        for _, instance in ipairs(workspace:GetDescendants()) do
            ApplyLocalOptimization(instance)
        end
        for _, instance in ipairs(Lighting:GetDescendants()) do
            ApplyLocalOptimization(instance)
        end
        if not OptimizeConnections.WorkspaceAdded then
            OptimizeConnections.WorkspaceAdded = workspace.DescendantAdded:Connect(ApplyLocalOptimization)
            OptimizeConnections.LightingAdded = Lighting.DescendantAdded:Connect(ApplyLocalOptimization)
        end
    else
        if OptimizeConnections.WorkspaceAdded then
            OptimizeConnections.WorkspaceAdded:Disconnect()
            OptimizeConnections.WorkspaceAdded = nil
        end
        if OptimizeConnections.LightingAdded then
            OptimizeConnections.LightingAdded:Disconnect()
            OptimizeConnections.LightingAdded = nil
        end
        for instance, saved in pairs(OptimizeSaved) do
            if instance and instance.Parent then
                pcall(function() instance[saved.property] = saved.value end)
            end
        end
        table.clear(OptimizeSaved)
    end

    OptimizeButton.Text = "TỐI ƯU SCRIPT : " .. (enabled and "ON" or "OFF")
    OptimizeButton.BackgroundColor3 = enabled and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)
end

OptimizeButton.MouseButton1Click:Connect(function()
    SetOptimize(not OPTIMIZE_ENABLED)
end)

