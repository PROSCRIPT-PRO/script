local function SetFullBrightness(enabled)
    MISC_FULL_BRIGHT = enabled
    if enabled then
        if not BrightnessBackup then
            BrightnessBackup = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                FogEnd = Lighting.FogEnd,
                GlobalShadows = Lighting.GlobalShadows,
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient
            }
        end
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180,180,180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180,180,180)
    elseif BrightnessBackup then
        for property,value in pairs(BrightnessBackup) do
            Lighting[property] = value
        end
        BrightnessBackup = nil
    end
    FullBrightButton.Text = "FULL BRIGHTNESS : "..(enabled and "ON" or "OFF")
    FullBrightButton.BackgroundColor3 = enabled and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)
end

