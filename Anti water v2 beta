--====================================
-- FIND RIVER
--====================================

local function ReplacePart(Part)

    if not Part:IsA("BasePart") then
        return
    end

    if Part.Name:lower() ~= "river" then
        return
    end

    if Replaced[Part] then
        return
    end

    Replaced[Part] = true

    local OldCFrame = Part.CFrame
    local OldSize = Part.Size
    local OldColor = Part.Color

    local NewPart = Instance.new("Part")

    NewPart.Name = "AntiWaterPart"
    NewPart.CFrame = OldCFrame
    NewPart.Size = OldSize
    NewPart.Color = OldColor

    NewPart.Anchored = true
    NewPart.CanCollide = true
    NewPart.Transparency = 0
    NewPart.Material = Enum.Material.Plastic

    NewPart.Parent = Workspace

    -- Ẩn river trên máy local
    Part.LocalTransparencyModifier = 1
    Part.CanCollide = false

    Status.Text = "River replaced"
end

--====================================
-- SCAN
--====================================

local function Scan()

    local Count = 0

    for _, Object in ipairs(Workspace:GetDescendants()) do

        if Object:IsA("BasePart")
            and Object.Name:lower() == "river" then

            ReplacePart(Object)
            Count += 1
        end
    end

    Status.Text = "Found: " .. Count
end

--====================================
-- TOGGLE
--====================================

Button.MouseButton1Click:Connect(function()

    Active = not Active

    if Active then

        Button.Text = "ON"
        Button.BackgroundColor3 =
            Color3.fromRGB(20, 150, 80)

        Scan()

        Connection = Workspace.DescendantAdded:Connect(
            function(Object)

                if not Active then
                    return
                end

                if Object:IsA("BasePart")
                    and Object.Name:lower() == "river" then

                    task.wait(0.1)
                    ReplacePart(Object)
                end
            end
        )

    else

        Button.Text = "OFF"
        Button.BackgroundColor3 =
            Color3.fromRGB(150, 40, 40)

        if Connection then
            Connection:Disconnect()
            Connection = nil
        end

        Status.Text = "Disabled"
    end
end)
