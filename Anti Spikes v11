--==================================================
-- WARNING
--==================================================

local LastWarning = 0

local function Warn()
    if not WarningOn or os.clock()-LastWarning < 3 then
        return
    end

    LastWarning = os.clock()

    pcall(function()
        StarterGui:SetCore("SendNotification",{
            Title = "ANTI SPIKES",
            Text = "Spike nearby!",
            Duration = 2
        })
    end)
end

--==================================================
-- MAIN UPDATE
--==================================================

local function Update()
    if not Enabled then
        Status.Text = "Disabled"
        Placement.Text = "Placement: Disabled"
        return
    end

    local found = {}

    for _,v in ipairs(WS:GetDescendants()) do
        if IsSpike(v) then
            table.insert(found,v)
        end
    end

    for Model in pairs(Data) do
        if not Model.Parent or not table.find(found,Model) then
            Remove(Model)
        end
    end

    local sorted = {}
    local holding,waiting,locked = 0,0,0

    for _,Model in ipairs(found) do
        local d = Data[Model] or {}
        Data[Model] = d

        local state = CheckState(Model,d)

        if state == "HOLDING" or state == "MOVING" then
            RemoveShield(d)

            if state == "HOLDING" then
                holding += 1
            end

        elseif state == "WAITING" then
            waiting += 1

        elseif state == "PLACED" then
            if ShieldOn and not d.Locked then
                AddShield(Model,d)
            end

            if d.Locked then
                locked += 1
            end
        end

        if HighlightOn then
            AddHighlight(Model,d)
        elseif d.Highlight then
            d.Highlight.Enabled = false
        end

        table.insert(sorted,{
            Model = Model,
            Distance = Distance(Model)
        })
    end

    table.sort(sorted,function(a,b)
        return a.Distance < b.Distance
    end)

    for i,item in ipairs(sorted) do
        local d = Data[item.Model]

        if d.Highlight then
            d.Highlight.Enabled = HighlightOn and i <= MAX_HIGHLIGHT
        end
    end

    if sorted[1] and sorted[1].Distance <= WARNING_DISTANCE then
        Warn()
    end

    Status.Text = "Models: "..#found.." | Locked: "..locked

    if holding > 0 then
        Placement.Text = "Placement: Holding"
    elseif waiting > 0 then
        Placement.Text = "Placement: Waiting 1.5s"
    elseif locked > 0 then
        Placement.Text = "Placement: Locked"
    else
        Placement.Text = "Placement: Searching"
    end
end

