--==================================================
-- DRAG FOR TOUCH / MOUSE
--==================================================

local function Drag(object,handle)
    local active,start,pos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            active = input
            start = input.Position
            pos = object.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if active and
        (input == active or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position-start
            object.Position = UDim2.new(
                pos.X.Scale,pos.X.Offset+delta.X,
                pos.Y.Scale,pos.Y.Offset+delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input == active then active = nil end
    end)
end

