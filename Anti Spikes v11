--==================================================
-- SPIKE DETECTION
--==================================================

local function Has(Model,name)
    for _,v in ipairs(Model:GetDescendants()) do
        if v.Name:lower() == name:lower() then
            return true
        end
    end
    return false
end

local function IsSpike(Model)
    return Model:IsA("Model")
        and Has(Model,"Hitbox")
        and Has(Model,"RootPart")
        and Has(Model,"Touchy")
end

local Data = {}

local function RemoveShield(d)
    if d.Shield then
        d.Shield:Destroy()
        d.Shield = nil
    end
    d.Locked = false
end

local function Remove(Model)
    local d = Data[Model]
    if not d then return end

    if d.Highlight then
        d.Highlight:Destroy()
    end

    RemoveShield(d)
    Data[Model] = nil
end

--==================================================
-- CHARACTER / DISTANCE
--==================================================

local function Root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Distance(Model)
    local r = Root()
    if not r then return math.huge end
    return (r.Position-Model:GetPivot().Position).Magnitude
end

--==================================================
-- HIGHLIGHT
--==================================================

local function AddHighlight(Model,d)
    if d.Highlight then return end

    local h = Instance.new("Highlight")
    h.Adornee = Model
    h.FillColor = ACCENT
    h.OutlineColor = Color3.new(1,1,1)
    h.FillTransparency = 0.65
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = Model
    d.Highlight = h
end

--==================================================
-- SHIELD
--==================================================

local function AddShield(Model,d)
    if d.Shield then return end

    local ok,cf,size = pcall(function()
        return Model:GetBoundingBox()
    end)

    if not ok then return end

    local p = Instance.new("Part")
    p.Name = "AntiSpikesV10_Shield"
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = false
    p.CanQuery = false
    p.Transparency = 0.5
    p.Color = ACCENT
    p.Material = Enum.Material.ForceField
    p.CastShadow = false
    p.Size = size
    p.CFrame = cf
    p.Parent = WS

    d.Shield = p
    d.Locked = true
end

--==================================================
-- HOLD / PLACE DETECTION
--==================================================

local function CheckState(Model,d)
    local pivot = Model:GetPivot()
    local now = os.clock()
    local root = Root()

    if not d.LastPivot then
        d.LastPivot = pivot
        d.LastTime = now
        d.StillSince = now
        d.LastRoot = root and root.Position
        return "WAITING"
    end

    local dt = math.max(now-d.LastTime,0.001)
    local delta = (pivot.Position-d.LastPivot.Position).Magnitude
    local speed = delta/dt

    local follows = false

    if root and d.LastRoot then
        local rootDelta = root.Position-d.LastRoot
        local modelDelta = pivot.Position-d.LastPivot.Position

        if rootDelta.Magnitude > 0.15 and delta > 0.05 then
            follows = (modelDelta-rootDelta).Magnitude < 0.8
                and Distance(Model) < 18
        end
    end

    d.LastPivot = pivot
    d.LastTime = now
    d.LastRoot = root and root.Position

    if follows then
        d.StillSince = nil
        return "HOLDING"
    end

    if speed > 0.08 then
        d.StillSince = nil
        return "MOVING"
    end

    d.StillSince = d.StillSince or now

    if now-d.StillSince >= DELAY then
        return "PLACED"
    end

    return "WAITING"
end

