--==================================================
-- DỊCH CHUYỂN LÊN LOOP
--==================================================

task.spawn(
	function()

		while Gui.Parent do

			if VIEW_MOVE
				and Root
				and Root.Parent then

				local char =
					LP.Character

				local humanoid =
					char and
					char:FindFirstChildOfClass(
						"Humanoid"
					)

				if humanoid
					and humanoid.Health > 0 then

					Root.CFrame =
						Root.CFrame +
						Vector3.new(
							0,
							VIEW_DISTANCE,
							0
						)
				end
			end

			task.wait(
				VIEW_DELAY
			)
		end
	end
)

--==================================================
-- RESOURCE FUNCTIONS
--==================================================

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or
			obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)
	end
end

local function GetType(obj)

	local n =
		obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"
	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"
	end

	if n:find("apple") then
		return "Apple"
	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"
	end
end

local function ScanResources()

	local NewCache = {
		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}
	}

	for _,obj in ipairs(
		workspace:GetDescendants()
	) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t =
				GetType(obj)

			local r =
				t and
				GetRoot(obj)

			if t and r then

				table.insert(
					NewCache[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)
			end
		end
	end

	Cache =
		NewCache
end

--==================================================
-- PLAYER CACHE
--==================================================

local function ScanPlayers()

	if not Root then

		PlayersCache = {}

		return
	end

	local list = {}

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h
				and h.Health > 0 then

				table.insert(
					list,
					{
						Player = p,
						Root = r,
						Type = "Player",
						Name = p.DisplayName,
						Distance =
							(
								Root.Position -
								r.Position
							).Magnitude
					}
				)
			end
		end
	end

	table.sort(
		list,
		function(a,b)
			return a.Distance <
				b.Distance
		end
	)

	PlayersCache = {}

	for i = 1,
		math.min(
			MAX_PLAYER,
			#list
		) do

		PlayersCache[i] =
			list[i]
	end
end

--==================================================
-- FARM TARGET
--==================================================

local function GetFarmTarget()

	if not Root then
		return nil
	end

	if FARM_TYPE ==
		"Player" then

		local best
		local bestDistance =
			math.huge

		for _,data in ipairs(
			PlayersCache
		) do

			if data.Root
				and data.Root.Parent then

				local d =
					(
						Root.Position -
						data.Root.Position
					).Magnitude

				if d < bestDistance then

					bestDistance = d
					best = data
				end
			end
		end

		return best
	end

	local best
	local bestDistance =
		math.huge

	for _,data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		if data.Root
			and data.Root.Parent then

			local d =
				(
					Root.Position -
					data.Root.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data
			end
		end
	end

	return best
end

--==================================================
-- AI TARGET
--==================================================

local function GetNearestResource()

	if not Root then
		return nil
	end

	local best
	local bestDistance =
		math.huge

	for resourceType,list in pairs(
		Cache
	) do

		for _,data in ipairs(list) do

			if data.Root
				and data.Root.Parent then

				local d =
					(
						Root.Position -
						data.Root.Position
					).Magnitude

				if d < bestDistance then

					bestDistance = d

					best =
						{
							Root = data.Root,
							Type = resourceType,
							Name = resourceType,
							Distance = d
						}
				end
			end
		end
	end

	return best
end

local function GetNearestAIPlayer()

	if not Root then
		return nil
	end

	local best
	local bestDistance =
		math.huge

	for _,data in ipairs(
		PlayersCache
	) do

		if data.Root
			and data.Root.Parent then

			local d =
				(
					Root.Position -
					data.Root.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data
			end
		end
	end

	return best
end

local function GetAITarget()

	if AI_TARGET_MODE ==
		"RESOURCE" then

		return GetNearestResource()
	end

	if AI_TARGET_MODE ==
		"PLAYER" then

		return GetNearestAIPlayer()
	end

	local resource =
		GetNearestResource()

	local player =
		GetNearestAIPlayer()

	if not resource then
		return player
	end

	if not player then
		return resource
	end

	if resource.Distance <=
		player.Distance then

		return resource
	end

	return player
end

--==================================================
-- RAYCAST
--==================================================

local function IsObstacleAhead(
	targetPosition
)

	if not Root then
		return false
	end

	local direction =
		targetPosition -
		Root.Position

	if direction.Magnitude <= 2 then
		return false
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances =
		{
			Character
		}

	local result =
		workspace:Raycast(
			Root.Position +
				Vector3.new(
					0,
					2,
					0
				),
			direction.Unit *
				math.min(
					direction.Magnitude,
					8
				),
			params
		)

	return result ~= nil
end

--==================================================
-- PATHFINDING
--==================================================

local function ComputeAIPath(
	targetPosition
)

	if not Root
		or not Humanoid then

		return false
	end

	local path =
		PathfindingService:CreatePath(
			{
				AgentRadius = 2,
				AgentHeight = 5,
				AgentCanJump = true,
				AgentCanClimb = true,
				WaypointSpacing = 3
			}
		)

	local success =
		pcall(
			function()

				path:ComputeAsync(
					Root.Position,
					targetPosition
				)
			end
		)

	if not success
		or path.Status ~=
			Enum.PathStatus.Success then

		AI_WAYPOINTS = {}
		AI_WAYPOINT_INDEX = 1

		return false
	end

	AI_WAYPOINTS =
		path:GetWaypoints()

	AI_WAYPOINT_INDEX = 1

	AI_LAST_PATH =
		os.clock()

	return #AI_WAYPOINTS > 0
end

--==================================================
-- MOVE AI
--==================================================

local function MoveAI(target)

	if not Humanoid
		or not Root
		or not target
		or not target.Root
		or not target.Root.Parent then

		return
	end

	local targetPosition =
		target.Root.Position

	local distance =
		(
			Root.Position -
			targetPosition
		).Magnitude

	if distance <=
		AI_REACH_DISTANCE then

		Humanoid:MoveTo(
			Root.Position
		)

		return
	end

	local needNewPath =
		AI_LAST_TARGET ~=
			target.Root

		or
		#AI_WAYPOINTS == 0

		or
		AI_WAYPOINT_INDEX >
			#AI_WAYPOINTS

		or
		os.clock() -
			AI_LAST_PATH >
			AI_PATH_RECOMPUTE

	if needNewPath then

		AI_LAST_TARGET =
			target.Root

		ComputeAIPath(
			targetPosition
		)
	end

	local waypoint =
		AI_WAYPOINTS[
			AI_WAYPOINT_INDEX
		]

	if waypoint then

		if IsObstacleAhead(
			waypoint.Position
		) then

			ComputeAIPath(
				targetPosition
			)

			waypoint =
				AI_WAYPOINTS[
					AI_WAYPOINT_INDEX
				]
		end

		if waypoint then

			if waypoint.Action ==
				Enum.PathWaypointAction.Jump then

				Humanoid.Jump = true
			end

			Humanoid:MoveTo(
				waypoint.Position
			)

			if (
				Root.Position -
				waypoint.Position
			).Magnitude <= 3 then

				AI_WAYPOINT_INDEX += 1
			end
		end

	else

		Humanoid:MoveTo(
			targetPosition
		)
	end
end

--==================================================
-- AUTO WEAPON
--==================================================

local function FindTool()

	if Character then

		for _,obj in ipairs(
			Character:GetChildren()
		) do

			if obj:IsA("Tool") then
				return obj
			end
		end
	end

	local Backpack =
		LP:FindFirstChildOfClass(
			"Backpack"
		)

	if Backpack then

		for _,obj in ipairs(
			Backpack:GetChildren()
		) do

			if obj:IsA("Tool") then
				return obj
			end
		end
	end

	return nil
end

local function EquipAndUseTool()

	if not AI_WEAPON then
		return
	end

	if not Character
		or not Humanoid then

		return
	end

	local Tool =
		FindTool()

	if not Tool then
		return
	end

	if Tool.Parent ~=
		Character then

		pcall(
			function()
				Humanoid:EquipTool(
					Tool
				)
			end
		)

		task.wait(0.05)
	end

	if Tool.Parent ==
		Character then

		pcall(
			function()
				Tool:Activate()
			end
		)
	end
end

task.spawn(
	function()

		while Gui.Parent do

			if AI_AUTO_PLAY
				and AI_WEAPON then

				EquipAndUseTool()
			end

			task.wait(
				AI_WEAPON_INTERVAL
			)
		end
	end
)

--==================================================
-- AI LOOP
--==================================================

task.spawn(
	function()

		while Gui.Parent do

			if AI_AUTO_PLAY then

				local char =
					LP.Character

				Humanoid =
					char and
					char:FindFirstChildOfClass(
						"Humanoid"
					)

				Root =
					char and
					char:FindFirstChild(
						"HumanoidRootPart"
					)

				if Humanoid
					and Root
					and Humanoid.Health > 0 then

					Humanoid.WalkSpeed =
						FARM_SPEED

					local target =
						GetAITarget()

					if target
						and target.Root
						and target.Root.Parent then

						MoveAI(target)

						local distance =
							(
								Root.Position -
								target.Root.Position
							).Magnitude

						AIStatus.Text =
							"AI STATUS: RUNNING\n\n" ..
							"Target: " ..
							(
								target.Name or
								"Unknown"
							) ..
							"\nDistance: " ..
							math.floor(
								distance
							) ..
							"\nMovement: Pathfinding\n" ..
							"Obstacle Avoidance: ON\n" ..
							"Raycast: ON\n" ..
							"Weapon: " ..
							(
								AI_WEAPON and
								"ON" or
								"OFF"
							)

					else

						AIStatus.Text =
							"AI STATUS: SEARCHING\n\n" ..
							"Không tìm thấy mục tiêu\n" ..
							"Đang quét map..."

						AI_LAST_TARGET = nil
						AI_WAYPOINTS = {}
					end
				end

			else

				AIStatus.Text =
					"AI STATUS: READY\n\n" ..
					"Target: " ..
					AI_TARGET_MODE ..
					"\nMovement: Pathfinding\n" ..
					"Obstacle Avoidance: ON\n" ..
					"Raycast: ON\n" ..
					"Weapon: " ..
					(
						AI_WEAPON and
						"ON" or
						"OFF"
					)
			end

			task.wait(
				AI_UPDATE
			)
		end
	end
)

