--==================================================
-- SPEED LOOP
--==================================================

task.spawn(
	function()

		while Gui.Parent do

			if SPEED
				and Root
				and Root.Parent then

				local direction =
					Root.CFrame.LookVector

				local horizontal =
					Vector3.new(
						direction.X,
						0,
						direction.Z
					)

				if horizontal.Magnitude >
					0.001 then

					horizontal =
						horizontal.Unit

					Root.CFrame =
						Root.CFrame +
						horizontal *
						SPEED_DISTANCE
				end
			end

			task.wait(
				SPEED_INTERVAL
			)
		end
	end
)

