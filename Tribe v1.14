			220,
			220,
			220
		)

	Button.Font =
		Enum.Font.GothamBold

	Button.TextSize = 8

	Button.BorderSizePixel = 0

	Button.Parent =
		Sidebar

	local Corner =
		Instance.new(
			"UICorner"
		)

	Corner.CornerRadius =
		UDim.new(
