--==================================================
-- DRAG
--==================================================

local function Drag(frame)

	local active = false
	local start
	local position

	frame.InputBegan:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				active = true

				start =
					input.Position

				position =
					frame.Position
			end
		end
	)

	UIS.InputChanged:Connect(
		function(input)

			if not active then
				return
			end

			if input.UserInputType ~=
				Enum.UserInputType.MouseMovement
				and
				input.UserInputType ~=
				Enum.UserInputType.Touch then

				return
			end

			local delta =
				input.Position -
				start

			frame.Position =
				UDim2.new(
					position.X.Scale,
					position.X.Offset +
						delta.X,
					position.Y.Scale,
					position.Y.Offset +
						delta.Y
				)
		end
	)

	UIS.InputEnded:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				active = false
			end
		end
	)
end

local function DragPowerButton(
	frame
)

	local active = false
	local start
	local position

	frame.InputBegan:Connect(
		function(input)

			if POWER_LOCK then
				return
			end

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				active = true

				start =
					input.Position

				position =
					frame.Position
			end
		end
	)

	UIS.InputChanged:Connect(
		function(input)

			if not active then
				return
			end

			if POWER_LOCK then

				active = false
				return
			end

			if input.UserInputType ~=
				Enum.UserInputType.MouseMovement
				and
				input.UserInputType ~=
				Enum.UserInputType.Touch then

				return
			end

			local delta =
				input.Position -
				start

			frame.Position =
				UDim2.new(
					position.X.Scale,
					position.X.Offset +
						delta.X,
					position.Y.Scale,
					position.Y.Offset +
						delta.Y
				)
		end
	)

	UIS.InputEnded:Connect(
		function(input)

			if input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				input.UserInputType ==
				Enum.UserInputType.Touch then

				active = false
			end
		end
	)
end

