local function SetAuraInterval(
	x
)

	local left =
		AuraIntervalSlider.AbsolutePosition.X

	local width =
		AuraIntervalSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x - left) / width,
			0,
			1
		)

	AURA_INTERVAL =
		math.floor(
			(
				AURA_MIN_INTERVAL +
				(
					AURA_MAX_INTERVAL -
					AURA_MIN_INTERVAL
				) *
				scale
			) * 10 + 0.5
		) / 10

	local knobScale =
		(
			AURA_INTERVAL -
			AURA_MIN_INTERVAL
		) /
		(
			AURA_MAX_INTERVAL -
			AURA_MIN_INTERVAL
		)

	AuraIntervalKnob.Position =
		UDim2.new(
			knobScale,
			-8,
			0,
			0
		)

	AuraIntervalLabel.Text =
		"AURA INTERVAL: " ..
		string.format(
			"%.1f",
			AURA_INTERVAL
		) ..
		"S"
end

AuraIntervalSlider.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			auraIntervalDragging = true

			SetAuraInterval(
				input.Position.X
			)
		end
	end
)

UIS.InputChanged:Connect(
	function(input)

		if not auraIntervalDragging then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			SetAuraInterval(
				input.Position.X
			)
		end
	end
)

UIS.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			auraIntervalDragging = false
		end
	end
)

