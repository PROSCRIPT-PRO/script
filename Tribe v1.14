--==================================================
-- PAGE SYSTEM
--==================================================

local Pages = {}

local function CreatePage(name)

	local Page =
		Instance.new(
			"ScrollingFrame"
		)

	Page.Name = name

	Page.Size =
		UDim2.fromScale(
			1,
			1
		)

	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0

	Page.ScrollBarThickness = 3

	Page.CanvasSize =
		UDim2.new(
			0,
			0,
			0,
			560
		)

	Page.Visible = false

	Page.Parent =
		Content

	Pages[name] =
		Page

	return Page
end

