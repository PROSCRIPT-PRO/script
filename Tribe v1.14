--==================================================
-- AURA TELEPORT
--==================================================

task.spawn(
	function()

		while Gui.Parent do

			if AURA_TELEPORT then

				local char =
					LP.Character

				local root =
					char and
					char:FindFirstChild(
						"HumanoidRootPart"
					)

				if root then

					local nearestRoot
					local nearestDistance =
						AURA_DISTANCE

					for _,player in ipairs(
						Players:GetPlayers()
					) do

						if player ~= LP then

							local targetChar =
								player.Character

							local targetRoot =
								targetChar and
								targetChar:FindFirstChild(
									"HumanoidRootPart"
								)

							local targetHumanoid =
								targetChar and
								targetChar:FindFirstChildOfClass(
									"Humanoid"
								)

							if targetRoot
								and targetHumanoid
								and targetHumanoid.Health > 0 then

								local distance =
									(
										root.Position -
										targetRoot.Position
									).Magnitude

								if distance <=
									nearestDistance then

									nearestDistance =
										distance

									nearestRoot =
										targetRoot
								end
							end
						end
					end

					if nearestRoot then

						root.CFrame =
							nearestRoot.CFrame
					end
				end
			end

			task.wait(
				AURA_INTERVAL
			)
		end
	end
)

--==================================================
-- POWER
--==================================================

local function UsePower()

	if not POWER
		or POWER_COOLDOWN then

		return
	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	POWER_COOLDOWN = true

	root.CFrame =
		root.CFrame +
		root.CFrame.LookVector *
		POWER_DISTANCE

	task.delay(
		2,
		function()
			POWER_COOLDOWN = false
		end
	)
end

