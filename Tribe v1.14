--==================================================
-- TAB SWITCH
--==================================================

local function OpenTab(name)

	for pageName,page in pairs(
		Pages
	) do

		page.Visible =
			pageName == name
	end

	for buttonName,button in pairs(
		SidebarButtons
	) do

		if buttonName == name then

			button.BackgroundColor3 =
				Color3.fromRGB(
					0,
					170,
					255
				)

			button.TextColor3 =
				Color3.new(
					1,
					1,
					1
				)

		else

			button.BackgroundColor3 =
				Color3.fromRGB(
					48,
					48,
					48
				)

			button.TextColor3 =
				Color3.fromRGB(
					220,
					220,
					220
				)
		end
	end
end

MainTab.MouseButton1Click:Connect(
	function()
		OpenTab("MAIN")
	end
)

AimTab.MouseButton1Click:Connect(
	function()
		OpenTab("AIM")
	end
)

AutoPlayTab.MouseButton1Click:Connect(
