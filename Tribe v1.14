local function CheckNearbyPlayers()

	if not WARNING then

		WarningLabel.Visible = false
		return
	end

	if not Root then
		return
	end

	local nearestPlayer
	local nearestDistance =
		math.huge

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r and h
				and h.Health > 0 then

				local d =
					(
						Root.Position -
						r.Position
					).Magnitude

				if d < nearestDistance then

					nearestDistance = d
					nearestPlayer = p
				end
			end
		end
	end

	if nearestPlayer
		and nearestDistance <=
			WARNING_DISTANCE then

		WarningLabel.Text =
			"⚠ " ..
			nearestPlayer.DisplayName ..
			" đang ở " ..
			math.floor(
				nearestDistance
			) ..
			"m!"

		WarningLabel.Visible = true

	else

		WarningLabel.Visible = false
	end
end

WarningButton.MouseButton1Click:Connect(
	function()

		WARNING =
			not WARNING

		WarningButton.Text =
			WARNING and
			"WARNING 200M : ON" or
			"WARNING 200M : OFF"

		WarningButton.BackgroundColor3 =
			WARNING and
			Color3.fromRGB(
				40,
				180,
				40
			) or
			Color3.fromRGB(
				50,
				50,
				50
			)

		if not WARNING then
			WarningLabel.Visible = false
		end
	end
)

task.spawn(
	function()

		while Gui.Parent do

			CheckNearbyPlayers()

			task.wait(0.5)
		end
	end
)

