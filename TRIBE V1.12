	Color3.fromRGB(
		180,
		50,
		50
	)

WarningLabel.BackgroundTransparency =
	0.15

WarningLabel.TextColor3 =
	Color3.new(
		1,
		1,
		1
	)

WarningLabel.Font =
	Enum.Font.GothamBold

WarningLabel.TextSize = 13

WarningLabel.Text =
	"⚠ KHÔNG CÓ NGƯỜI GẦN"

WarningLabel.Visible = false
WarningLabel.ZIndex = 400
WarningLabel.Parent = Gui

local WarningCorner =
	Instance.new("UICorner")

WarningCorner.CornerRadius =
	UDim.new(
		0,
		10
	)

WarningCorner.Parent = WarningLabel

local function CheckNearbyPlayers()

	if not WARNING then

		WarningLabel.Visible = false
		return

	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local nearestPlayer
	local nearestDistance =
		math.huge

	for _, p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r
				and h
				and h.Health > 0 then

				local d =
					(
						root.Position -
						r.Position
					).Magnitude

				if d < nearestDistance then

					nearestDistance = d
					nearestPlayer = p

				end

			end

		end

	end

	if nearestPlayer
		and nearestDistance <=
			WARNING_DISTANCE then

		WarningLabel.Text =
			"⚠ " ..
			nearestPlayer.DisplayName ..
			" đang ở " ..
			math.floor(
				nearestDistance
			) ..
			"m!"

		WarningLabel.Visible = true

	else

		WarningLabel.Visible = false

	end

end

task.spawn(function()

	while Gui.Parent do

		CheckNearbyPlayers()

		task.wait(0.5)

	end

end)

WarningButton.MouseButton1Click:Connect(function()

	WARNING =
		not WARNING

	WarningButton.Text =
		WARNING
		and "WARNING 200M : ON"
		or "WARNING 200M : OFF"

	WarningButton.BackgroundColor3 =
		WARNING
		and Color3.fromRGB(
			40,
			180,
			40
		)
		or Color3.fromRGB(
			50,
			50,
			50
		)

	if not WARNING then
		WarningLabel.Visible = false
	end

end)

