-- POWER
--==================================================

local function SetPower(value)

	POWER = value

	PowerButton.Text =
		POWER
		and "POWER : ON"
		or "POWER : OFF"

	PowerButton.BackgroundColor3 =
		POWER
		and Color3.fromRGB(
			40,
			180,
			40
		)
		or Color3.fromRGB(
			50,
			50,
			50
		)

end

PowerButton.MouseButton1Click:Connect(function()

	SetPower(
		not POWER
	)

end)

