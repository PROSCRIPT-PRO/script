--==================================================
-- CHARACTER
--==================================================

local Character
local Humanoid
local Root
local AntiPart

local CreateAntiPart

--==================================================
-- CREATE ANTI WATER PART
--==================================================

CreateAntiPart = function()

	if not ANTI_WATER then
		return
	end

	if not Character
		or not Character.Parent
		or not Root
		or not Root.Parent then
		return
	end

	if AntiPart then
		AntiPart:Destroy()
		AntiPart = nil
	end

	AntiPart = Instance.new("Part")

	AntiPart.Name = "AntiWaterPart"

	AntiPart.Size = PART_SIZE

	AntiPart.Transparency = 1

	AntiPart.CanCollide = true
	AntiPart.CanTouch = false
	AntiPart.CanQuery = false

	AntiPart.Massless = true
	AntiPart.CastShadow = false
	AntiPart.Anchored = false

	AntiPart.CFrame =
		Root.CFrame *
		CFrame.new(PART_OFFSET)

	AntiPart.Parent = Character

	local Weld = Instance.new("WeldConstraint")

	Weld.Part0 = Root
	Weld.Part1 = AntiPart
	Weld.Parent = AntiPart

end

--==================================================
-- CHARACTER SETUP
--==================================================

local function SetupCharacter(char)

	Character = char

	Humanoid =
		char:WaitForChild("Humanoid")

	Root =
		char:WaitForChild("HumanoidRootPart")

	if AntiPart then
		AntiPart:Destroy()
		AntiPart = nil
	end

	task.wait(0.1)

	if ANTI_WATER then
		CreateAntiPart()
	end

	-- AIM FIX AFTER RESPAWN
	if AIM and Humanoid then
		AIM_AUTO_ROTATE_OLD =
			Humanoid.AutoRotate

		Humanoid.AutoRotate = false
	end

end

if LP.Character then
	SetupCharacter(LP.Character)
end

LP.CharacterAdded:Connect(function(char)

	SetupCharacter(char)

end)

