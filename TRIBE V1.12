		or "AIM : OFF"

	AIMButton.BackgroundColor3 =
		AIM
		and Color3.fromRGB(
			40,
			180,
			40
		)
		or Color3.fromRGB(
			50,
			50,
			50
		)

	if Humanoid then

		if AIM then

			AIM_AUTO_ROTATE_OLD =
				Humanoid.AutoRotate

			Humanoid.AutoRotate = false

		else

			Humanoid.AutoRotate =
				AIM_AUTO_ROTATE_OLD

		end

	end

	if not AIM then
		AIM_TARGET = nil
	end

end)

