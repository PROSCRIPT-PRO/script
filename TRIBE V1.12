local AIMDragging = false

local function SetAIMDistance(x)

	local left =
		AIMSlider.AbsolutePosition.X

	local width =
		AIMSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x - left) / width,
			0,
			1
		)

	AIM_DISTANCE =
		math.floor(
			AIM_MIN_DISTANCE +
			(
				AIM_MAX_DISTANCE -
				AIM_MIN_DISTANCE
			) * scale
			+ 0.5
		)

	AIMKnob.Position =
		UDim2.new(
			scale,
			-8,
			0,
			0
		)

	AIMDistanceLabel.Text =
		"AIM DISTANCE: " ..
		AIM_DISTANCE

end

AIMSlider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		AIMDragging = true

		SetAIMDistance(
			input.Position.X
		)

	end

end)

UIS.InputChanged:Connect(function(input)

	if not AIMDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SetAIMDistance(
			input.Position.X
		)

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		AIMDragging = false

	end

end)

--==================================================
-- AIM TARGET
--==================================================

local function GetCharacterData(player)

	if not player
		or player == LP then

		return nil
	end

	local character =
		player.Character

	if not character
		or not character.Parent then

		return nil
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root
		or not humanoid
		or humanoid.Health <= 0 then

		return nil
	end

	return character,
		root,
		humanoid

end

local function FindNearestPlayer()

	local char =
		LP.Character

	local root =
		char
		and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	local nearest = nil
	local nearestDistance =
		AIM_DISTANCE

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LP then

			local targetChar,
				targetRoot,
				targetHumanoid =
				GetCharacterData(player)

			if targetChar
				and targetRoot
				and targetHumanoid then

				local distance =
					(
						root.Position -
						targetRoot.Position
					).Magnitude

				if distance <= nearestDistance then

					nearestDistance =
						distance

					nearest =
						player

				end

			end

		end

	end

	return nearest

end

