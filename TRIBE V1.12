--==================================================
-- RESOURCE CACHE
--==================================================

local Cache = {

	Wood = {},
	Stone = {},
	Apple = {},
	Food = {}

}

local function GetRoot(obj)

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then

		return obj.PrimaryPart
			or obj:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

end

local function GetType(obj)

	local n =
		obj.Name:lower()

	if n:find("wood")
		or n:find("tree")
		or n:find("log") then

		return "Wood"

	end

	if n:find("stone")
		or n:find("rock")
		or n:find("ore") then

		return "Stone"

	end

	if n:find("apple") then

		return "Apple"

	end

	if n:find("food")
		or n:find("meat")
		or n:find("berry")
		or n:find("fish") then

		return "Food"

	end

end

local function ScanResources()

	local NewCache = {

		Wood = {},
		Stone = {},
		Apple = {},
		Food = {}

	}

	for _, obj in ipairs(
		workspace:GetDescendants()
	) do

		if obj:IsA("BasePart")
			or obj:IsA("Model") then

			local t =
				GetType(obj)

			local r =
				t and GetRoot(obj)

			if t and r then

				table.insert(
					NewCache[t],
					{
						Root = r,
						Type = t,
						Name = t
					}
				)

			end

		end

	end

	Cache =
		NewCache

end

--==================================================
-- PLAYER CACHE
--==================================================

local PlayersCache = {}

local function ScanPlayers()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then

		PlayersCache = {}

		return

	end

	local list = {}

	for _, p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			local c =
				p.Character

			local r =
				c and
				c:FindFirstChild(
					"HumanoidRootPart"
				)

			local h =
				c and
				c:FindFirstChildOfClass(
					"Humanoid"
				)

			if r
				and h
				and h.Health > 0 then

				table.insert(
					list,
					{
						Player = p,
						Root = r,
						Type = "Player",
						Name = p.DisplayName,
						Distance =
							(
								root.Position -
								r.Position
							).Magnitude
					}
				)

			end

		end

	end

	table.sort(
		list,
		function(a, b)

			return a.Distance <
				b.Distance

		end
	)

	PlayersCache = {}

	for i = 1,
		math.min(
			MAX_PLAYER,
			#list
		) do

		PlayersCache[i] =
			list[i]

	end

end

--==================================================
-- FARM TARGET
--==================================================

local function GetFarmTarget()

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	if FARM_TYPE == "Player" then

		local best
		local bestDistance =
			math.huge

		for _, data in ipairs(
			PlayersCache
		) do

			if data.Root
				and data.Root.Parent then

				local d =
					(
						root.Position -
						data.Root.Position
					).Magnitude

				if d < bestDistance then

					bestDistance = d
					best = data

				end

			end

		end

		return best

	end

	local best
	local bestDistance =
		math.huge

	for _, data in ipairs(
		Cache[FARM_TYPE] or {}
	) do

		local r =
			data.Root

		if r and r.Parent then

			local d =
				(
					root.Position -
					r.Position
				).Magnitude

			if d < bestDistance then

				bestDistance = d
				best = data

			end

		end

	end

	return best

end

--==================================================
-- AUTO FARM LOOP
--==================================================

task.spawn(function()

	while Gui.Parent do

		if AUTO_FARM then

			local char =
				LP.Character

			local humanoid =
				char and
				char:FindFirstChildOfClass(
					"Humanoid"
				)

			local root =
				char and
				char:FindFirstChild(
					"HumanoidRootPart"
				)

			if humanoid and root then

				humanoid.WalkSpeed =
					FARM_SPEED

				local target =
					GetFarmTarget()

				if target
					and target.Root then

					humanoid:MoveTo(
						target.Root.Position
					)

				end

			end

		end

		task.wait(0.15)

	end

end)

--==================================================
-- POWER USE
--==================================================

local function UsePower()

	if not POWER
		or POWER_COOLDOWN then

		return

	end

	local char =
		LP.Character

	local root =
		char and
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	POWER_COOLDOWN = true

	root.CFrame =
		root.CFrame +
		root.CFrame.LookVector *
		POWER_DISTANCE

	task.delay(
		2,
		function()

			POWER_COOLDOWN = false

		end
	)

end

