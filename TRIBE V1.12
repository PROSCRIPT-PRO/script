PowerSliderCorner.Parent = PowerSlider

local PowerKnob =
	Instance.new("Frame")

PowerKnob.Size =
	UDim2.fromOffset(
		14,
		14
	)

PowerKnob.Position =
	UDim2.new(
		0,
		-7,
		0,
		0
	)

PowerKnob.BackgroundColor3 =
	Color3.fromRGB(
		0,
		170,
		255
	)

PowerKnob.BorderSizePixel = 0
PowerKnob.Parent = PowerSlider

local PowerKnobCorner =
	Instance.new("UICorner")

PowerKnobCorner.CornerRadius =
	UDim.new(
		0,
		7
	)

PowerKnobCorner.Parent = PowerKnob

local powerDragging = false

local function SetPowerDistance(x)

	local left =
		PowerSlider.AbsolutePosition.X

	local width =
		PowerSlider.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local scale =
		math.clamp(
			(x - left) / width,
			0,
			1
		)

	POWER_DISTANCE =
		math.floor(
			10 +
			scale * 20 +
			0.5
		)

	PowerKnob.Position =
		UDim2.new(
			scale,
			-7,
			0,
			0
		)

	PowerDistanceLabel.Text =
		"POWER DISTANCE: " ..
		POWER_DISTANCE

end

PowerSlider.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerDragging = true

		SetPowerDistance(
			input.Position.X
		)

	end

end)

UIS.InputChanged:Connect(function(input)

	if not powerDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		SetPowerDistance(
			input.Position.X
		)

	end

end)

-- FIX 1
UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		powerDragging = false

	end

end)

