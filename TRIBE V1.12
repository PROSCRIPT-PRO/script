end)

--==================================================
-- AIM LOOP
--==================================================

RunService.RenderStepped:Connect(function()

	if not AIM then
		return
	end

	local char =
		LP.Character

	local humanoid =
		char
		and char:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		char
		and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not char
		or not humanoid
		or not root then

		return

	end

	-- FIX 3:
	-- Roblox AutoRotate không được ghi đè AIM
	humanoid.AutoRotate = false

	local target =
		AIM_TARGET

	if not target then
		return
	end

	local targetChar,
		targetRoot,
		targetHumanoid =
		GetCharacterData(target)

	if not targetChar
		or not targetRoot
		or not targetHumanoid then

		AIM_TARGET = nil
		return

	end

	local distance =
		(
			root.Position -
			targetRoot.Position
		).Magnitude

	if distance > AIM_DISTANCE then

		AIM_TARGET = nil
		return

	end

	-- CHỈ XOAY NGANG
	local targetPosition =
		Vector3.new(
			targetRoot.Position.X,
			root.Position.Y,
			targetRoot.Position.Z
		)

	local direction =
		targetPosition -
		root.Position

	if direction.Magnitude > 0.05 then

		root.CFrame =
			CFrame.lookAt(
				root.Position,
				targetPosition
			)

	end

end)

