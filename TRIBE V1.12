	Label.BackgroundTransparency = 1
	Label.Text = text

	Label.TextColor3 =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Label.Font =
		Enum.Font.GothamBold

	Label.TextSize = 14

	Label.TextXAlignment =
		Enum.TextXAlignment.Left

	Label.Parent = parent

	return Label

end

--==================================================
-- NORMAL BUTTON
--==================================================

local function CreateButton(parent, text, y)

	local Button =
		Instance.new("TextButton")

	Button.Size =
		UDim2.new(
			1,
			-20,
			0,
			34
		)

	Button.Position =
		UDim2.fromOffset(
			10,
			y
		)

	Button.BackgroundColor3 =
		Color3.fromRGB(
			50,
			50,
			50
		)

	Button.Text = text

	Button.TextColor3 =
		Color3.new(
			1,
			1,
			1
		)

	Button.Font =
		Enum.Font.GothamBold

	Button.TextSize = 11

	Button.BorderSizePixel = 0
	Button.Parent = parent

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(
			0,
			7
		)

	Corner.Parent = Button

	return Button

end

