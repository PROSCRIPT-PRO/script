FarmSelect.MouseButton1Click:Connect(function()

	FarmIndex += 1

	if FarmIndex > #FarmTypes then
		FarmIndex = 1
	end

	FARM_TYPE =
		FarmTypes[FarmIndex]

	FarmSelect.Text =
		"FARM: " ..
		FARM_TYPE ..
		" ▼"

end)

