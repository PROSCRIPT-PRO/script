--==================================================
-- PAGE SYSTEM
--==================================================

local Pages = {}

local function CreatePage(name)

	local Page =
		Instance.new("Frame")

	Page.Name = name

	Page.Size =
		UDim2.fromScale(
			1,
			1
		)

	Page.BackgroundTransparency = 1
	Page.Visible = false
	Page.Parent = Content

	Pages[name] = Page

	return Page

end

local InfoPage =
	CreatePage("INFO")

local MainPage =
	CreatePage("MAIN")

local AimPage =
	CreatePage("AIM")

local MiscPage =
	CreatePage("MISC")

local ScriptPage =
	CreatePage("SCRIPT")

--==================================================
-- SIDEBAR BUTTON
--==================================================

local SidebarButtons = {}

local function CreateSideButton(text, y)

	local Button =
		Instance.new("TextButton")

	Button.Size =
		UDim2.new(
			1,
			-10,
			0,
			40
		)

	Button.Position =
		UDim2.fromOffset(
			5,
			y
		)

	Button.BackgroundColor3 =
		Color3.fromRGB(
			48,
			48,
			48
		)

	Button.Text = text

	Button.TextColor3 =
		Color3.fromRGB(
			220,
			220,
			220
		)

	Button.Font =
		Enum.Font.GothamBold

	Button.TextSize = 11

	Button.BorderSizePixel = 0
	Button.Parent = Sidebar

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(
			0,
			6
		)

	Corner.Parent = Button

	SidebarButtons[text] = Button

	return Button

end

