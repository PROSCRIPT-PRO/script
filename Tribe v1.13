local function SetAIMDistance(x)
	local left = AIMSlider.AbsolutePosition.X
	local width = AIMSlider.AbsoluteSize.X
	if width <= 0 then return end

	local scale = math.clamp((x-left)/width,0,1)
	AIM_DISTANCE = math.floor(AIM_MIN_DISTANCE + (AIM_MAX_DISTANCE-AIM_MIN_DISTANCE)*scale + 0.5)
	AIMKnob.Position = UDim2.new(scale,-8,0,0)
	AIMDistanceLabel.Text = "AIM DISTANCE: "..AIM_DISTANCE
end

AIMSlider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		AIMDragging = true
		SetAIMDistance(input.Position.X)
	end
end)

UIS.InputChanged:Connect(function(input)
	if not AIMDragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		SetAIMDistance(input.Position.X)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		AIMDragging = false
	end
end)

local function GetCharacterData(player)
	if not player or player == LP then return nil end

	local character = player.Character
	if not character or not character.Parent then return nil end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return character,root,humanoid
end

local function FindNearestPlayer()
	if not Root then return nil end

	local nearest
	local nearestDistance = AIM_DISTANCE

	for _,player in ipairs(Players:GetPlayers()) do
		if player ~= LP then
			local _,targetRoot,targetHumanoid = GetCharacterData(player)

			if targetRoot and targetHumanoid then
				local distance = (Root.Position-targetRoot.Position).Magnitude

				if distance <= nearestDistance then
					nearestDistance = distance
					nearest = player
				end
			end
		end
	end

	return nearest
end

AIMButton.MouseButton1Click:Connect(function()
	AIM = not AIM
	AIMButton.Text = AIM and "AIM : ON" or "AIM : OFF"
	AIMButton.BackgroundColor3 = AIM and Color3.fromRGB(40,180,40) or Color3.fromRGB(50,50,50)

	if Humanoid then
		if AIM then
			AIM_AUTO_ROTATE_OLD = Humanoid.AutoRotate
			Humanoid.AutoRotate = false
		else
			Humanoid.AutoRotate = AIM_AUTO_ROTATE_OLD
		end
	end

	if not AIM then
		AIM_TARGET = nil
	end
end)

task.spawn(function()
	while Gui.Parent do
		AIM_TARGET = AIM and FindNearestPlayer() or nil
		task.wait(0.05)
	end
end)

RunService.RenderStepped:Connect(function()
	if not AIM or not Root or not Humanoid then return end

	Humanoid.AutoRotate = false

	local target = AIM_TARGET
	if not target then return end

	local _,targetRoot,targetHumanoid = GetCharacterData(target)

	if not targetRoot or not targetHumanoid then
		AIM_TARGET = nil
		return
	end

	local distance = (Root.Position-targetRoot.Position).Magnitude

	if distance > AIM_DISTANCE then
		AIM_TARGET = nil
		return
	end

	local targetPosition = Vector3.new(
		targetRoot.Position.X,
		Root.Position.Y,
		targetRoot.Position.Z
	)

	if (targetPosition-Root.Position).Magnitude > 0.05 then
		Root.CFrame = CFrame.lookAt(Root.Position,targetPosition)
	end
end)

