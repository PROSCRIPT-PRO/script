local SpeedKnob = Instance.new("Frame")
SpeedKnob.Size = UDim2.fromOffset(16,16)
SpeedKnob.Position = UDim2.new(
	(SPEED_DISTANCE-SPEED_MIN)/(SPEED_MAX-SPEED_MIN),
	-8,
	0,
	0
)
SpeedKnob.BackgroundColor3 = Color3.fromRGB(0,170,255)
SpeedKnob.BorderSizePixel = 0
SpeedKnob.Parent = SpeedSlider

