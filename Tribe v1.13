--==================================================
-- MEMORY
--==================================================

local MemoryButton =
	CreateButton(
		ScriptPage,
		"MEMORY: SAVE SLOT 1",
		125
	)

local MEMORY_SLOT = 1
local MAX_MEMORY_SLOT = 3
local MemoryData = {}

local MemoryLabel = Instance.new("TextLabel")
MemoryLabel.Size = UDim2.new(1,-20,0,20)
MemoryLabel.Position = UDim2.fromOffset(10,165)
MemoryLabel.BackgroundTransparency = 1
MemoryLabel.Text = "MEMORY SLOT: 1 / 3"
MemoryLabel.TextColor3 = Color3.fromRGB(200,200,200)
MemoryLabel.Font = Enum.Font.GothamBold
MemoryLabel.TextSize = 10
MemoryLabel.TextXAlignment = Enum.TextXAlignment.Left
MemoryLabel.Parent = ScriptPage

local function SaveMemory()
	MemoryData[MEMORY_SLOT] = {
		ESP = ESP,
		AIM = AIM,
		AIM_DISTANCE = AIM_DISTANCE,
		AUTO_FARM = AUTO_FARM,
		AI_AUTO_PLAY = AI_AUTO_PLAY,
		AURA_TELEPORT = AURA_TELEPORT,
		SPEED = SPEED,
		SPEED_DISTANCE = SPEED_DISTANCE,
		FARM_SPEED = FARM_SPEED,
		FARM_TYPE = FARM_TYPE,
		POWER = POWER,
		POWER_DISTANCE = POWER_DISTANCE,
		ANTI_AFK = ANTI_AFK,
		FULL_BRIGHT = FULL_BRIGHT,
		NO_FOG = NO_FOG,
		WARNING = WARNING,
		ANTI_WATER = ANTI_WATER,
		AI_TARGET_MODE = AI_TARGET_MODE,
		AI_WEAPON = AI_WEAPON
	}

	MemoryButton.Text =
		"MEMORY: SAVED SLOT "..MEMORY_SLOT
end

MemoryButton.MouseButton1Click:Connect(function()
	SaveMemory()

	MEMORY_SLOT += 1

	if MEMORY_SLOT > MAX_MEMORY_SLOT then
		MEMORY_SLOT = 1
	end

	MemoryLabel.Text =
		"MEMORY SLOT: "..MEMORY_SLOT.." / 3"

	task.delay(0.8,function()
		if MemoryButton.Parent then
			MemoryButton.Text =
				"MEMORY: SAVE SLOT "..MEMORY_SLOT
		end
	end)
end)

--==================================================
-- ESP
--==================================================

local Pool = {}

local function MakeESP()
	local Line = Instance.new("Frame")
	Line.Size = UDim2.fromOffset(0,2)
	Line.AnchorPoint = Vector2.new(0.5,0.5)
	Line.BackgroundColor3 = Color3.new(1,1,1)
	Line.BorderSizePixel = 0
	Line.Visible = false
	Line.ZIndex = 20
	Line.Parent = Gui

	local Text = Instance.new("TextLabel")
	Text.Size = UDim2.fromOffset(170,35)
	Text.AnchorPoint = Vector2.new(0.5,0.5)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = Color3.new(1,1,1)
	Text.TextStrokeTransparency = 0
	Text.Font = Enum.Font.GothamBold
	Text.TextSize = 13
	Text.Visible = false
	Text.ZIndex = 21
	Text.Parent = Gui

	return {
		Line = Line,
		Text = Text
	}
end

local TOTAL = MAX_PLAYER + MAX_RESOURCE*4

for i = 1,TOTAL do
	Pool[i] = MakeESP()
end

local function ESPColor(t)
	if t == "Player" then
		return Color3.fromRGB(0,255,0)
	elseif t == "Wood" then
		return Color3.fromRGB(170,100,40)
	elseif t == "Stone" then
		return Color3.fromRGB(200,200,200)
	elseif t == "Apple" then
		return Color3.fromRGB(255,40,40)
	elseif t == "Food" then
		return Color3.fromRGB(255,180,0)
	end

	return Color3.new(1,1,1)
end

local function HideESP()
	for _,e in ipairs(Pool) do
		e.Line.Visible = false
		e.Text.Visible = false
	end
end

RunService.RenderStepped:Connect(function()
	if not ESP then
		HideESP()
		return
	end

	local cam = workspace.CurrentCamera

	if not cam or not Root then
		HideESP()
		return
	end

	local targets = {}

	for _,d in ipairs(PlayersCache) do
		table.insert(targets,d)
	end

	for _,list in pairs(Cache) do
		local sorted = {}

		for _,d in ipairs(list) do
			if d.Root and d.Root.Parent then
				d.Distance =
					(Root.Position-d.Root.Position).Magnitude

				table.insert(sorted,d)
			end
		end

		table.sort(sorted,function(a,b)
			return a.Distance < b.Distance
		end)

		for i = 1,math.min(MAX_RESOURCE,#sorted) do
			table.insert(targets,sorted[i])
		end
	end

	local center =
		Vector2.new(
			cam.ViewportSize.X/2,
			cam.ViewportSize.Y/2
		)

	for i = 1,TOTAL do
		local e = Pool[i]
		local d = targets[i]

		if not d or not d.Root or not d.Root.Parent then
			e.Line.Visible = false
			e.Text.Visible = false
			continue
		end

		local pos =
			cam:WorldToViewportPoint(d.Root.Position)

		if pos.Z <= 0 then
			e.Line.Visible = false
			e.Text.Visible = false
			continue
		end

		local target = Vector2.new(pos.X,pos.Y)
		local diff = target-center
		local len = diff.Magnitude

		if len > 1 then
			e.Line.Position =
				UDim2.fromOffset(
					(center.X+target.X)/2,
					(center.Y+target.Y)/2
				)

			e.Line.Size = UDim2.fromOffset(len,2)

			e.Line.Rotation =
				math.deg(
					math.atan2(diff.Y,diff.X)
				)

			e.Line.BackgroundColor3 =
				ESPColor(d.Type)

			e.Line.Visible = true
		end

		e.Text.Position =
			UDim2.fromOffset(
				math.clamp(target.X,45,cam.ViewportSize.X-45),
				math.clamp(target.Y-25,20,cam.ViewportSize.Y-20)
			)

		e.Text.TextColor3 = ESPColor(d.Type)

		e.Text.Text =
			d.Name ..
			"\n" ..
			math.floor(d.Distance or 0) ..
			" m"

		e.Text.Visible = true
	end
end)

