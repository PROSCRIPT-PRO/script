--==================================================
-- PAGE SYSTEM
--==================================================

local Pages = {}

local function CreatePage(name)
	local Page = Instance.new("ScrollingFrame")
	Page.Name = name
	Page.Size = UDim2.fromScale(1,1)
	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0
	Page.ScrollBarThickness = 3
	Page.CanvasSize = UDim2.new(0,0,0,450)
	Page.Visible = false
	Page.Parent = Content
	Pages[name] = Page
	return Page
end

local InfoPage = CreatePage("INFO")
local MainPage = CreatePage("MAIN")
local AimPage = CreatePage("AIM")
local AutoPlayPage = CreatePage("AUTO PLAY")
local SpeedPage = CreatePage("SPEED")
local MiscPage = CreatePage("MISC")
local ScriptPage = CreatePage("SCRIPT")

--==================================================
-- SIDEBAR BUTTON
--==================================================

local SidebarButtons = {}

local function CreateSideButton(text,y)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,-10,0,34)
	Button.Position = UDim2.fromOffset(5,y)
	Button.BackgroundColor3 = Color3.fromRGB(48,48,48)
	Button.Text = text
	Button.TextColor3 = Color3.fromRGB(220,220,220)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 9
	Button.BorderSizePixel = 0
	Button.Parent = Sidebar

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,6)
	Corner.Parent = Button

	SidebarButtons[text] = Button
	return Button
end

local InfoTab = CreateSideButton("INFO",5)
local MainTab = CreateSideButton("MAIN",41)
local AimTab = CreateSideButton("AIM",77)
local AutoPlayTab = CreateSideButton("AUTO PLAY",113)
local SpeedTab = CreateSideButton("SPEED",149)
local MiscTab = CreateSideButton("MISC",185)
local ScriptTab = CreateSideButton("SCRIPT",221)

--==================================================
-- TAB SWITCH
--==================================================

local function OpenTab(name)
	for pageName,page in pairs(Pages) do
		page.Visible = pageName == name
	end

	for buttonName,button in pairs(SidebarButtons) do
		if buttonName == name then
			button.BackgroundColor3 = Color3.fromRGB(0,170,255)
			button.TextColor3 = Color3.new(1,1,1)
		else
			button.BackgroundColor3 = Color3.fromRGB(48,48,48)
			button.TextColor3 = Color3.fromRGB(220,220,220)
		end
	end
end

InfoTab.MouseButton1Click:Connect(function() OpenTab("INFO") end)
MainTab.MouseButton1Click:Connect(function() OpenTab("MAIN") end)
AimTab.MouseButton1Click:Connect(function() OpenTab("AIM") end)
AutoPlayTab.MouseButton1Click:Connect(function() OpenTab("AUTO PLAY") end)
SpeedTab.MouseButton1Click:Connect(function() OpenTab("SPEED") end)
MiscTab.MouseButton1Click:Connect(function() OpenTab("MISC") end)
ScriptTab.MouseButton1Click:Connect(function() OpenTab("SCRIPT") end)

