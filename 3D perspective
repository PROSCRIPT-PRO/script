--==================================================

local Enabled = true

local Distance = 12
local MinDistance = 3
local MaxDistance = 60

local Yaw = 0
local Pitch = math.rad(-15)

local Sensitivity = 0.012
local ZoomSensitivity = 0.025

local Root
