-- BUTTON
--==================================================

Toggle.Activated:Connect(function()
    Enabled = not Enabled

    if Enabled then
        Toggle.Text = "CAMERA ON"
        Toggle.BackgroundColor3 =
            Color3.fromRGB(0, 130, 90)

        EnableDefaultCamera()
    else
        Toggle.Text = "CAMERA OFF"
        Toggle.BackgroundColor3 =
            Color3.fromRGB(150, 45, 45)

        EnableCustomCamera()
    end
end)

