--==================================================
-- CLEAR OBJECTS
--==================================================

local function ClearObjects()

    for model, data in pairs(Objects) do

        if data.Box then
            data.Box:Destroy()
        end

        if data.Highlight then
            data.Highlight:Destroy()
        end

    end

    table.clear(Objects)
end

--==================================================
-- CREATE SHIELD
--==================================================

local function CreateShield(model)

    local Box = Instance.new("Part")

    Box.Name = "AntiSpikes_Shield"
    Box.Anchored = true

    Box.CanCollide = true
    Box.CanTouch = false
    Box.CanQuery = false

    Box.CastShadow = false
    Box.Material = Enum.Material.ForceField
    Box.Color = Color3.fromRGB(0, 170, 255)
    Box.Transparency = 0.45

    Box.Parent = Workspace

    local Highlight = Instance.new("Highlight")

    Highlight.Name = "AntiSpikes_Highlight"
    Highlight.Adornee = model
    Highlight.FillColor =
        Color3.fromRGB(0, 170, 255)

    Highlight.OutlineColor =
        Color3.fromRGB(0, 255, 255)

    Highlight.FillTransparency = 0.8
    Highlight.OutlineTransparency = 0

    Highlight.Parent = model

    return {
        Box = Box,
        Highlight = Highlight
    }
end

--==================================================
-- UPDATE SHIELD - REAL SIZE
--==================================================

local function UpdateShield(model, data)

    if not model.Parent then
        return
    end

    local Success, CF, Size = pcall(function()
        return model:GetBoundingBox()
    end)

    if not Success then
        return
    end

    data.Box.Size = Vector3.new(
        math.max(Size.X, 0.05),
        math.max(Size.Y, 0.05),
        math.max(Size.Z, 0.05)
    )

    data.Box.CFrame = CF
end

--==================================================
-- FIND SPIKES MODELS
--==================================================

local function FindSpikes()

    local Character = Player.Character

    local Root = Character and
        Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return {}, nil
    end

    local Found = {}
    local Seen = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if obj:IsA("Model")
            and obj.Name:lower() == "spikes"
            and not Seen[obj] then

            Seen[obj] = true

            local Position = obj:GetPivot().Position

            local Distance =
                (Position - Root.Position).Magnitude

            table.insert(Found, {
                Model = obj,
                Distance = Distance
            })

        end

    end

    table.sort(Found, function(a, b)
        return a.Distance < b.Distance
    end)

    return Found, Root
end

--==================================================
-- UPDATE SYSTEM
--==================================================

local function UpdateSystem()

    if not Enabled then
        return
    end

    local Found, Root = FindSpikes()

    if not Root then
        Status.Text = "Không tìm thấy nhân vật!"
        return
    end

    local Active = {}
    local NearCount = 0

    local TargetCount = math.min(#Found, MaxTargets)

    for i = 1, TargetCount do

        local model = Found[i].Model

        Active[model] = true

        if not Objects[model] then
            Objects[model] = CreateShield(model)
        end

        UpdateShield(model, Objects[model])

        if Found[i].Distance <= WarningDistance then
            NearCount += 1
        end

    end

    -- Remove old targets

    for model, data in pairs(Objects) do

        if not Active[model] or not model.Parent then

            if data.Box then
                data.Box:Destroy()
            end

            if data.Highlight then
                data.Highlight:Destroy()
            end

            Objects[model] = nil
        end

    end

    Status.Text = string.format(
        "ANTI SPIKES: ON\n" ..
        "Highlight: %d / 5\n" ..
        "Shield: %d / 5\n" ..
        "Spikes gần: %d\n" ..
        "Warning: %.0f studs",

        TargetCount,
        TargetCount,
        NearCount,
        WarningDistance
    )

    if NearCount > 0 and os.clock() - LastWarning >= 2 then

        LastWarning = os.clock()

        Notify("Phát hiện Spikes ở gần!")

    end

end

